{
  "name": "HSE Go Development",
  "dockerComposeFile": "../compose.yml",
  "service": "go",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go"
      ]
    }
  },
  "postCreateCommand": "go install golang.org/x/tools/gopls@latest"
}